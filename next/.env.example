# Brevo (formerly Sendinblue) Newsletter Configuration
# 1. Sign up at https://www.brevo.com/
# 2. Go to Settings -> API Keys -> Generate a new API key
# 3. Go to Contacts -> Lists -> Create or pick a list and grab its numerical ID from the URL (e.g. /id/2)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_LIST_ID=1

# ── Contact form / lead capture ─────────────────────────────────────
# Where new-lead notifications go (defaults to willardwells@gmail.com)
CONTACT_RECIPIENT_EMAIL=
# A sender address verified in Brevo (Senders & IP). Defaults to
# thecreativetechshop@gmail.com, the sender currently verified on the account.
# A domain address such as hello@thecreativetechnician.online delivers better.
CONTACT_SENDER_EMAIL=
# Brevo list that every enquiry is saved to (separate from the newsletter list)
BREVO_LEADS_LIST_ID=
# Optional: n8n/Zapier webhook that receives the full lead JSON (e.g. to append
# a Google Sheet row). If set, leads are captured even when email delivery fails.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# ── Public contact channels ─────────────────────────────────────────
# WhatsApp number, digits only with country code (defaults to 18768617153)
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Cal.com / Calendly link; "Book a call" buttons stay hidden until this is set
NEXT_PUBLIC_BOOKING_URL=
